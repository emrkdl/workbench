{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boardlens/cdm.v1",
  "title": "Canonical Design Model v1",
  "description": "CAD 포맷과 무관한 사내 중립 설계 모델. HKP 파서를 포함한 모든 입력 어댑터의 출력 계약이며, DB 스키마와 API와 UI는 이 모델만 알고 원본 포맷은 알지 못한다.",
  "x-module": "cdm_v1",
  "x-version": "1.0.0",
  "x-conventions": {
    "length": "모든 길이는 정수 나노미터(nm). 부동소수 누적 오차를 제거해 리비전 간 비교가 정확히 == 로 성립하게 한다. int64로 ±9,200km까지 표현되므로 어떤 보드도 넘지 않는다.",
    "angle": "각도는 1/1000도(mdeg), 반시계 방향, 0 이상 360000 미만.",
    "origin": "원점은 보드 외형의 좌하단. 인제스트 시점에 정규화한다.",
    "axis": "X는 우측, Y는 상방향. 화면 렌더 시에만 Y를 뒤집는다.",
    "layer_index": "물리 적층 순서. 1이 Top. 원본 CAD의 레이어명은 source_name에 보존한다.",
    "display_units": "mm/mil 변환은 표시 직전에만 수행한다. 저장·연산 경로에는 들어오지 않는다."
  },
  "$ref": "#/$defs/Design",

  "$defs": {

    "LayerRole": {
      "type": "string",
      "description": "적층 내 각 층의 물리적 역할.",
      "enum": ["signal", "plane_power", "plane_gnd", "mixed", "dielectric", "mask", "silk", "paste"]
    },

    "Side": {
      "type": "string",
      "description": "부품이 실장된 면.",
      "enum": ["top", "bottom"]
    },

    "ViaKind": {
      "type": "string",
      "description": "비아 종류. 블라인드/베리드/마이크로 유무가 제조 난이도와 단가를 크게 좌우한다.",
      "enum": ["through", "blind", "buried", "micro"]
    },

    "DrillKind": {
      "type": "string",
      "description": "홀 용도.",
      "enum": ["via", "mounting", "tooling", "component"]
    },

    "Severity": {
      "type": "string",
      "description": "DRC 위반 및 인제스트 경고의 심각도.",
      "enum": ["error", "warning", "info"]
    },

    "SourceUnits": {
      "type": "string",
      "description": "원본 파일이 사용하던 단위. 변환 이력 추적 목적으로만 보존하며 연산에는 쓰지 않는다.",
      "enum": ["nm", "um", "mm", "mil", "inch"]
    },

    "GeometryKind": {
      "type": "string",
      "description": ".blg 버퍼 안에서 종류별로 연속 배치되는 기하 객체의 분류.",
      "enum": ["trace", "pad", "via", "plane", "text", "outline"]
    },

    "Polygon": {
      "type": "object",
      "description": "닫힌 폴리곤. 보드 외형과 컷아웃 표현에 쓴다.",
      "additionalProperties": false,
      "required": ["points_nm", "is_cutout"],
      "properties": {
        "points_nm": {
          "type": "array",
          "description": "평탄화된 좌표 배열 [x0, y0, x1, y1, ...]. 첫 점과 끝 점은 중복하지 않으며 암묵적으로 닫힌다.",
          "items": { "type": "integer" }
        },
        "is_cutout": {
          "type": "boolean",
          "description": "true면 보드 내부에 뚫린 영역(컷아웃)."
        }
      }
    },

    "BBox": {
      "type": "object",
      "description": "축 정렬 경계 상자.",
      "additionalProperties": false,
      "required": ["x0_nm", "y0_nm", "x1_nm", "y1_nm"],
      "properties": {
        "x0_nm": { "type": "integer" },
        "y0_nm": { "type": "integer" },
        "x1_nm": { "type": "integer" },
        "y1_nm": { "type": "integer" }
      }
    },

    "DesignHeader": {
      "type": "object",
      "description": "설계의 신원과 물리적 외형. 카탈로그 목록에 보이는 대부분의 값이 여기서 나온다.",
      "additionalProperties": false,
      "required": [
        "board_key", "board_name", "revision_label",
        "source_tool", "source_version", "units_source",
        "outline", "board_thickness_nm"
      ],
      "properties": {
        "board_key": {
          "type": "string",
          "description": "설계 계보 식별자. 리비전이 바뀌어도 유지된다. 파일명이 아니라 파일 헤더에서 추출한다."
        },
        "board_name": { "type": "string", "description": "사람이 읽는 보드 이름." },
        "revision_label": { "type": "string", "description": "Rev A, 1.2 등 원본 표기 그대로." },
        "part_number": { "type": ["string", "null"], "description": "보드 자체의 사내 파트넘버." },
        "project_key": { "type": ["string", "null"], "description": "소속 프로젝트. 권한 경계이기도 하다." },
        "product_family": { "type": ["string", "null"], "description": "제품군. 카탈로그 파셋." },
        "author": { "type": ["string", "null"], "description": "설계자." },
        "designed_at": { "type": ["string", "null"], "description": "설계 시점 ISO-8601 날짜. 업로드 시점과 구분된다." },
        "source_tool": { "type": "string", "description": "원본 CAD 툴 이름." },
        "source_version": { "type": "string", "description": "원본 CAD 툴 버전. 파싱 분기와 이슈 추적에 쓴다." },
        "units_source": { "$ref": "#/$defs/SourceUnits" },
        "outline": {
          "type": "array",
          "description": "보드 외형. 이형 보드와 내부 컷아웃을 위해 다중 폴리곤.",
          "items": { "$ref": "#/$defs/Polygon" }
        },
        "board_thickness_nm": { "type": "integer", "description": "보드 총 두께." },
        "surface_finish": { "type": ["string", "null"], "description": "ENIG, HASL, OSP 등 표면 처리." },
        "special_processes": {
          "type": "array",
          "description": "리지드플렉스, 후동박, 임베디드 부품 등 특수 공정 태그.",
          "items": { "type": "string" }
        }
      }
    },

    "StackupLayer": {
      "type": "object",
      "description": "적층의 한 층. 도체층과 유전체층을 모두 포함하며 index 순서가 곧 물리 적층 순서다.",
      "additionalProperties": false,
      "required": ["index", "name", "source_name", "role", "thickness_nm"],
      "properties": {
        "index": { "type": "integer", "description": "1부터 시작하는 물리 적층 순서. 1이 Top." },
        "name": { "type": "string", "description": "정규화된 층 이름." },
        "source_name": { "type": "string", "description": "원본 CAD의 층 이름. 원본 대조용으로 절대 버리지 않는다." },
        "role": { "$ref": "#/$defs/LayerRole" },
        "thickness_nm": { "type": "integer", "description": "층 두께." },
        "material": { "type": ["string", "null"], "description": "재질명. FR-4, Megtron6 등." },
        "dk": { "type": ["number", "null"], "description": "유전 상수. 임피던스 검토에 필요." },
        "df": { "type": ["number", "null"], "description": "손실 계수." },
        "copper_weight_um": { "type": ["number", "null"], "description": "동박 두께(µm). 후동박 여부 판별." },
        "copper_area_ratio": { "type": ["number", "null"], "description": "동박 면적률 0~1. 휨·열 검토와 제조사 문의에 자주 요구된다." },
        "impedance_single_ohm": { "type": ["number", "null"], "description": "설계 단일단 임피던스." },
        "impedance_diff_ohm": { "type": ["number", "null"], "description": "설계 차동 임피던스." },
        "routed_net_count": { "type": ["integer", "null"], "description": "이 층에 배선된 넷 수. 파생값이지만 층별 밀도 파악에 자주 쓰여 보관한다." }
      }
    },

    "Pin": {
      "type": "object",
      "description": "부품의 핀 하나. 연결 정보는 여기 두지 않는다 — 회로 연결은 Net.pins 한 곳에서만 선언된다.",
      "additionalProperties": false,
      "required": ["name", "x_nm", "y_nm"],
      "properties": {
        "name": { "type": "string", "description": "핀 이름 또는 번호. 부품 내에서 유일." },
        "x_nm": { "type": "integer", "description": "보드 좌표계 기준 절대 X." },
        "y_nm": { "type": "integer", "description": "보드 좌표계 기준 절대 Y." },
        "layer_index": { "type": ["integer", "null"], "description": "패드가 놓인 층. 관통 핀은 null." },
        "pad_width_nm": { "type": ["integer", "null"], "description": "패드 폭." },
        "pad_height_nm": { "type": ["integer", "null"], "description": "패드 높이." }
      }
    },

    "Component": {
      "type": "object",
      "description": "배치된 부품 하나. refdes가 리비전 간 비교의 1차 매칭 키다.",
      "additionalProperties": false,
      "required": ["refdes", "package", "x_nm", "y_nm", "rotation_mdeg", "side", "pins"],
      "properties": {
        "refdes": { "type": "string", "description": "R12, U3 등. 리비전 내에서 유일해야 하며 중복 시 적재를 거부한다." },
        "part_number": { "type": ["string", "null"], "description": "제조사 파트넘버(MPN). 부품 역검색과 EOL 영향 분석의 핵심 필드." },
        "manufacturer": { "type": ["string", "null"], "description": "제조사." },
        "value": { "type": ["string", "null"], "description": "100nF, 10k 등 수동 소자 값." },
        "package": { "type": "string", "description": "0402, QFN48, BGA256 등 패키지 타입." },
        "x_nm": { "type": "integer", "description": "부품 원점 X." },
        "y_nm": { "type": "integer", "description": "부품 원점 Y." },
        "rotation_mdeg": { "type": "integer", "description": "1/1000도 단위 반시계 회전. 0 이상 360000 미만." },
        "side": { "$ref": "#/$defs/Side" },
        "height_nm": { "type": ["integer", "null"], "description": "부품 높이. 기구 간섭 검토에 쓴다." },
        "pin_pitch_nm": { "type": ["integer", "null"], "description": "핀 피치. BGA 최소 피치 집계에 쓴다." },
        "pins": {
          "type": "array",
          "description": "이 부품의 핀 목록.",
          "items": { "$ref": "#/$defs/Pin" }
        }
      }
    },

    "NetPinRef": {
      "type": "object",
      "description": "넷에 연결된 핀 하나. 회로 연결의 원자 단위이며 넷리스트 Diff는 이 집합의 차집합이다.",
      "additionalProperties": false,
      "required": ["refdes", "pin_name"],
      "properties": {
        "refdes": { "type": "string" },
        "pin_name": { "type": "string" }
      }
    },

    "LayerLength": {
      "type": "object",
      "description": "층별 배선 길이 내역.",
      "additionalProperties": false,
      "required": ["layer_index", "length_nm"],
      "properties": {
        "layer_index": { "type": "integer" },
        "length_nm": { "type": "integer" }
      }
    },

    "Net": {
      "type": "object",
      "description": "하나의 전기적 넷. name은 리비전 사이에서 바뀔 수 있으므로 signature가 실질적 동일성 판정을 맡는다.",
      "additionalProperties": false,
      "required": ["name", "pins", "length_nm", "via_count", "unrouted"],
      "properties": {
        "name": { "type": "string", "description": "넷 이름. Diff의 1차 매칭 키." },
        "signature": {
          "type": ["string", "null"],
          "description": "정렬된 refdes.pin 집합의 해시. 이름이 바뀐 넷과 실제로 회로가 바뀐 넷을 구분하는 열쇠. 파서가 아니라 정규화 단계에서 채운다."
        },
        "net_class": { "type": ["string", "null"], "description": "전원, 차동, 고속 등 설계자가 부여한 분류." },
        "diff_partner": { "type": ["string", "null"], "description": "차동쌍 상대 넷 이름." },
        "pins": {
          "type": "array",
          "description": "연결된 핀 목록. 회로 연결이 선언되는 유일한 자리.",
          "items": { "$ref": "#/$defs/NetPinRef" }
        },
        "length_nm": { "type": "integer", "description": "총 배선 길이." },
        "length_by_layer": {
          "type": "array",
          "description": "층별 배선 길이 내역.",
          "items": { "$ref": "#/$defs/LayerLength" }
        },
        "via_count": { "type": "integer", "description": "이 넷이 사용하는 비아 수." },
        "width_nm": { "type": ["integer", "null"], "description": "공칭 선폭." },
        "unrouted": { "type": "boolean", "description": "미배선 여부." }
      }
    },

    "ViaSpec": {
      "type": "object",
      "description": "동일 사양 비아의 집계. 개별 비아 위치는 기하 버퍼에 있고 여기에는 통계만 둔다.",
      "additionalProperties": false,
      "required": ["kind", "from_layer", "to_layer", "drill_nm", "pad_nm", "count"],
      "properties": {
        "kind": { "$ref": "#/$defs/ViaKind" },
        "from_layer": { "type": "integer" },
        "to_layer": { "type": "integer" },
        "drill_nm": { "type": "integer", "description": "드릴 직경." },
        "pad_nm": { "type": "integer", "description": "패드 직경." },
        "count": { "type": "integer" }
      }
    },

    "DrillEntry": {
      "type": "object",
      "description": "드릴 표의 한 행. 제조 발주 시 그대로 쓰이는 정보.",
      "additionalProperties": false,
      "required": ["diameter_nm", "plated", "kind", "count"],
      "properties": {
        "diameter_nm": { "type": "integer" },
        "plated": { "type": "boolean", "description": "도금 홀(PTH) 여부." },
        "kind": { "$ref": "#/$defs/DrillKind" },
        "count": { "type": "integer" }
      }
    },

    "DesignRules": {
      "type": "object",
      "description": "설계에 실제로 적용된 최소값들. 제조 가능성과 단가를 결정하며 카탈로그 파셋으로도 쓴다.",
      "additionalProperties": false,
      "required": ["min_trace_width_nm", "min_clearance_nm", "min_drill_nm"],
      "properties": {
        "min_trace_width_nm": { "type": "integer", "description": "최소 선폭." },
        "min_clearance_nm": { "type": "integer", "description": "최소 간격." },
        "min_drill_nm": { "type": "integer", "description": "최소 드릴 직경." },
        "min_annular_ring_nm": { "type": ["integer", "null"], "description": "최소 애뉼러 링." },
        "max_aspect_ratio": { "type": ["number", "null"], "description": "최대 종횡비(보드 두께 / 최소 드릴)." },
        "min_bga_pitch_nm": { "type": ["integer", "null"], "description": "BGA 최소 피치. 조립 난이도의 대표 지표." }
      }
    },

    "DrcFinding": {
      "type": "object",
      "description": "CAD 툴이 낸 DRC 결과 한 건. BoardLens는 DRC를 재실행하지 않고 결과를 표시만 한다.",
      "additionalProperties": false,
      "required": ["rule", "severity", "message"],
      "properties": {
        "rule": { "type": "string", "description": "위반한 룰 이름." },
        "severity": { "$ref": "#/$defs/Severity" },
        "message": { "type": "string" },
        "x_nm": { "type": ["integer", "null"] },
        "y_nm": { "type": ["integer", "null"] },
        "layer_index": { "type": ["integer", "null"] },
        "net_name": { "type": ["string", "null"] },
        "refdes": { "type": ["string", "null"] }
      }
    },

    "LayerGeometryRef": {
      "type": "object",
      "description": "층 하나의 기하 버퍼(.blg)를 가리키는 포인터. 실제 좌표 데이터는 DB에 들어가지 않고 blob 스토어에 있으며, 브라우저가 API를 거치지 않고 직접 받는다.",
      "additionalProperties": false,
      "required": ["layer_index", "storage_key", "object_count", "byte_size", "bbox", "kind_counts"],
      "properties": {
        "layer_index": { "type": "integer" },
        "storage_key": { "type": "string", "description": "blob 스토어 내 경로." },
        "object_count": { "type": "integer" },
        "byte_size": { "type": "integer", "description": "gzip 압축 후 바이트 크기." },
        "bbox": { "$ref": "#/$defs/BBox" },
        "kind_counts": {
          "type": "object",
          "description": "기하 종류별 객체 수. 키는 GeometryKind 값.",
          "additionalProperties": { "type": "integer" }
        }
      }
    },

    "IngestWarning": {
      "type": "object",
      "description": "인제스트 무결성 검사에서 나온 경고. 실패가 아니라 기록이며 리비전 상세에 표시된다. 실제 설계 데이터는 원래 조금씩 지저분하고, 그걸 이유로 적재를 거부하면 아무도 시스템을 쓰지 않는다.",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "count"],
      "properties": {
        "code": { "type": "string", "description": "component_outside_outline, orphan_net 등 기계 판독 가능한 코드." },
        "severity": { "$ref": "#/$defs/Severity" },
        "message": { "type": "string" },
        "count": { "type": "integer", "description": "동일 코드가 합쳐진 건수." }
      }
    },

    "Design": {
      "type": "object",
      "description": "CDM 문서 루트. 입력 어댑터 하나가 파일 하나를 읽어 정확히 이 형태를 내놓는다.",
      "additionalProperties": false,
      "required": [
        "cdm_version", "header", "stackup", "components", "nets",
        "vias", "drills", "design_rules"
      ],
      "properties": {
        "cdm_version": { "type": "string", "description": "이 문서가 따르는 CDM 버전. 재파싱 판정에 쓴다." },
        "parser_name": { "type": ["string", "null"], "description": "생성한 어댑터 이름. hkp, mockgen 등." },
        "parser_version": { "type": ["string", "null"], "description": "어댑터 버전. 상승하면 전체 재파싱 대상이 된다." },
        "header": { "$ref": "#/$defs/DesignHeader" },
        "stackup": { "type": "array", "items": { "$ref": "#/$defs/StackupLayer" } },
        "components": { "type": "array", "items": { "$ref": "#/$defs/Component" } },
        "nets": { "type": "array", "items": { "$ref": "#/$defs/Net" } },
